<?xml version="1.0" encoding="UTF-8"?>
<jaxb:bindings version="3.0" xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb" 
               xmlns:xs="http://www.w3.org/2001/XMLSchema" 
               xmlns:xjc="http://java.sun.com/xml/ns/jaxb/xjc"
               xmlns:annox="urn:jaxb.jvnet.org:annox"
               xmlns:namespace="urn:jaxb.jvnet.org:plugin:namespace-prefix" 
               jaxb:schemaLocation="
               https://jakarta.ee/xml/ns/jaxb
               https://jakarta.ee/xml/ns/jaxb/bindingschema_3_0.xsd
               http://www.w3.org/2001/XMLSchema
               http://www.w3.org/2001/XMLSchema.xsd"
               jaxb:extensionBindingPrefixes="xjc namespace annox">

    <jaxb:bindings schemaLocation="gfc/gfc.xsd" 
                       node="/xs:schema">
        <jaxb:globalBindings
            fixedAttributeAsConstantProperty="true"
            typesafeEnumBase="xs:string"
            typesafeEnumMemberName="generateName" 
            generateIsSetMethod="true">
            <xjc:noValidator />
            <xjc:noValidatingUnmarshaller />
        </jaxb:globalBindings>

        <jaxb:schemaBindings>
            <jaxb:package name="org.geosdi.geoplatform.xml.gfc"/>
        </jaxb:schemaBindings>
        <namespace:prefix name="gfc"/>
        <!-- Elemento radice aggiunto a mano alla classe generata. -->
        <jaxb:bindings node="xs:complexType[@name='FC_FeatureCatalogue_Type']">
            <annox:annotateClass>@jakarta.xml.bind.annotation.XmlRootElement(name = "FC_FeatureCatalogue")</annox:annotateClass>
        </jaxb:bindings>
    </jaxb:bindings>
        
    <jaxb:bindings schemaLocation="iso/19139/20070417/gmd/gmd.xsd" 
                       node="/xs:schema">

        <jaxb:schemaBindings>
            <jaxb:package name="org.geosdi.geoplatform.xml.iso19139.v20070417.gmd"/>
        </jaxb:schemaBindings>
    </jaxb:bindings>

    <jaxb:bindings schemaLocation="iso/19139/20070417/gco/gco.xsd" 
                       node="/xs:schema">
        <jaxb:schemaBindings>
            <jaxb:package name="org.geosdi.geoplatform.xml.iso19139.v20070417.gco"/>
        </jaxb:schemaBindings>
    </jaxb:bindings>

    <jaxb:bindings schemaLocation="iso/19139/20070417/gmx/gmx.xsd" 
                       node="/xs:schema">
        <jaxb:schemaBindings>
            <jaxb:package name="org.geosdi.geoplatform.xml.iso19139.v20070417.gmx"/>
        </jaxb:schemaBindings>
    </jaxb:bindings>

    <jaxb:bindings schemaLocation="iso/19139/20070417/gsr/gsr.xsd" 
                       node="/xs:schema">
        <jaxb:schemaBindings>
            <jaxb:package name="org.geosdi.geoplatform.xml.iso19139.v20070417.gsr"/>
        </jaxb:schemaBindings>
    </jaxb:bindings>

    <jaxb:bindings schemaLocation="iso/19139/20070417/gss/gss.xsd" 
                       node="/xs:schema">
        <jaxb:schemaBindings>
            <jaxb:package name="org.geosdi.geoplatform.xml.iso19139.v20070417.gss"/>
        </jaxb:schemaBindings>
    </jaxb:bindings>

    <jaxb:bindings schemaLocation="iso/19139/20070417/gts/gts.xsd" 
                       node="/xs:schema">
        <jaxb:schemaBindings>
            <jaxb:package name="org.geosdi.geoplatform.xml.iso19139.v20070417.gts"/>
        </jaxb:schemaBindings>
    </jaxb:bindings>

</jaxb:bindings>
