<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    
    <parent>
        <groupId>org.geosdi</groupId>
        <artifactId>iso-19139</artifactId>
        <version>2.1-SNAPSHOT</version>
    </parent>

    <groupId>org.geosdi</groupId>
    <artifactId>geoplatform-iso19139-v20060504</artifactId>
    <version>2.1-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Geo-Platform :: == Binding ISO19139 (2006-05-04) XML Module</name>
    <url>http://maven.apache.org</url>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>jakarta.xml.bind</groupId>
            <artifactId>jakarta.xml.bind-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.glassfish.jaxb</groupId>
            <artifactId>jaxb-runtime</artifactId>
        </dependency>

        <dependency>
            <groupId>org.jvnet.jaxb</groupId>
            <artifactId>jaxb-plugins-runtime</artifactId>
        </dependency>

        
        <dependency>
            <groupId>org.geosdi</groupId>
            <artifactId>gml-3.2.0</artifactId>
        </dependency>
        
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
        </dependency>
    </dependencies>
    
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>**/*.xml</exclude>
                        <exclude>**/*.properties</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <plugin>
                <inherited>true</inherited>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <configuration>

                    <classifier>sources</classifier>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-sources</id>
<phase>verify</phase>
<goals>
    <goal>jar-no-fork</goal>
</goals>

                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>

            <!-- mvn jaxb2:generate -X -->
            <plugin>
                <groupId>org.jvnet.jaxb</groupId>
                <artifactId>jaxb-maven-plugin</artifactId>

                <configuration>
                    <schemaIncludes>
                        <value>iso/19139/*/gco/gco.xsd</value>
                        <value>iso/19139/*/gmd/gmd.xsd</value>
                        <value>iso/19139/*/gml/gml.xsd</value>
                        <value>iso/19139/*/gmx/gmx.xsd</value>
                        <value>iso/19139/*/gsr/gsr.xsd</value>
                        <value>iso/19139/*/gss/gss.xsd</value>
                        <value>iso/19139/*/gts/gts.xsd</value>
                        <value>iso/19139/*/srv/srv.xsd</value>
                    </schemaIncludes>
                    <episodes>
                        <episode>
                            <groupId>org.geosdi</groupId>
                            <artifactId>gml-3.2.0</artifactId>
                        </episode>
                    </episodes>
                </configuration>
            </plugin>
        </plugins>
    </build> 
</project>
