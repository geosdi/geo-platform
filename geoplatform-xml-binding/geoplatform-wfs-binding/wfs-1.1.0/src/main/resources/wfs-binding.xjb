<?xml version="1.0" encoding="UTF-8"?>
<jaxb:bindings version="3.0" xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb" 
               xmlns:xs="http://www.w3.org/2001/XMLSchema" 
               xmlns:xjc="http://java.sun.com/xml/ns/jaxb/xjc" 
               jaxb:schemaLocation="
               https://jakarta.ee/xml/ns/jaxb
               https://jakarta.ee/xml/ns/jaxb/bindingschema_3_0.xsd
               http://www.w3.org/2001/XMLSchema
               http://www.w3.org/2001/XMLSchema.xsd"
               jaxb:extensionBindingPrefixes="xjc">

    <jaxb:bindings schemaLocation="wfs/1.1.0/wfs.xsd" 
                       node="/xs:schema">
        <jaxb:schemaBindings>
            <jaxb:package name="org.geosdi.geoplatform.xml.wfs.v110"/>
        </jaxb:schemaBindings>
    </jaxb:bindings>
</jaxb:bindings>