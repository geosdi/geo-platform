<?xml version="1.0" encoding="UTF-8"?>
<jaxb:bindings version="3.0" xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb" 
               xmlns:xs="http://www.w3.org/2001/XMLSchema" 
               xmlns:xjc="http://java.sun.com/xml/ns/jaxb/xjc"
               xmlns:annox="urn:jaxb.jvnet.org:annox" 
               jaxb:schemaLocation="
               https://jakarta.ee/xml/ns/jaxb
               https://jakarta.ee/xml/ns/jaxb/bindingschema_3_0.xsd
               http://www.w3.org/2001/XMLSchema
               http://www.w3.org/2001/XMLSchema.xsd"
               jaxb:extensionBindingPrefixes="xjc annox">

    <jaxb:bindings schemaLocation="wmc/1.1.0/context.xsd"
                   node="/xs:schema">
        <jaxb:globalBindings
            fixedAttributeAsConstantProperty="true"
            typesafeEnumBase="xs:string"
            typesafeEnumMemberName="generateName" 
            generateIsSetMethod="true">
            <xjc:noValidator />
            <xjc:noValidatingUnmarshaller />
        </jaxb:globalBindings>
        
        <jaxb:schemaBindings>
            <jaxb:package name="org.geosdi.geoplatform.xml.wmc.v110"/>
        </jaxb:schemaBindings>

        <!-- Elementi radice aggiunti a mano alle classi generate (dal 2015). -->
        <jaxb:bindings node="xs:complexType[@name='ExtensionType']">
            <annox:annotateClass>@jakarta.xml.bind.annotation.XmlRootElement(name = "Extension")</annox:annotateClass>
        </jaxb:bindings>
        <jaxb:bindings node="xs:complexType[@name='FormatListType']">
            <annox:annotateClass>@jakarta.xml.bind.annotation.XmlRootElement(name = "FormatList")</annox:annotateClass>
        </jaxb:bindings>
        <jaxb:bindings node="xs:complexType[@name='GeneralType']">
            <annox:annotateClass>@jakarta.xml.bind.annotation.XmlRootElement(name = "General")</annox:annotateClass>
        </jaxb:bindings>
        <jaxb:bindings node="xs:complexType[@name='LayerListType']">
            <annox:annotateClass>@jakarta.xml.bind.annotation.XmlRootElement(name = "LayerList")</annox:annotateClass>
        </jaxb:bindings>
        <jaxb:bindings node="xs:complexType[@name='LayerType']">
            <annox:annotateClass>@jakarta.xml.bind.annotation.XmlRootElement(name = "Layer")</annox:annotateClass>
        </jaxb:bindings>
        <jaxb:bindings node="xs:complexType[@name='ServerType']">
            <annox:annotateClass>@jakarta.xml.bind.annotation.XmlRootElement(name = "Server")</annox:annotateClass>
        </jaxb:bindings>
        <jaxb:bindings node="xs:complexType[@name='StyleListType']">
            <annox:annotateClass>@jakarta.xml.bind.annotation.XmlRootElement(name = "StyleList")</annox:annotateClass>
        </jaxb:bindings>
        <jaxb:bindings node="xs:complexType[@name='ViewContextType']">
            <annox:annotateClass>@jakarta.xml.bind.annotation.XmlRootElement(name = "ViewContextType")</annox:annotateClass>
        </jaxb:bindings>
    </jaxb:bindings>

</jaxb:bindings>